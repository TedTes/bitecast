{
  "name": "bitecast",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "postinstall": "npm run patches",
    "patches": "patch-package --patch-dir apps/mobile/patches",
    "mobile": "npm --prefix apps/mobile run start",
    "typecheck": "npm --prefix apps/mobile run typecheck",
    "test": "npm --workspace @bitecast/engine test && npm --prefix apps/mobile test"
  }
}
